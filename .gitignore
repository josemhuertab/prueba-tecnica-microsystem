# =============================================
# .gitignore — Portal Microsystem
# =============================================

# Maven / Java — carpeta de compilación generada automáticamente
backend/target/

# Base de datos SQLite — se genera al iniciar el backend, no debe subirse
*.db
*.db-shm
*.db-wal

# Node.js — dependencias instaladas localmente
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Variables de entorno
.env
.env.local
.env.*.local

# IDEs
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db
